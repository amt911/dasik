{
  "metadata": {
    "note": "ufw firewall backend (smb + syncthing) for the QEMU VM harness (scripts/vmtest/qemu.sh install). Targets the guest's /dev/vda. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-ufw",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "firewall": {
    "enable": true,
    "backend": "ufw",
    "rules": [
      "allow 22000/tcp",
      "allow 21027/udp",
      "allow 445/tcp",
      "allow 139/tcp",
      "limit 22/tcp"
    ]
  }
}
