{
  "metadata": {
    "note": "Btrfs root (@ + @home) declaring compress-force=zstd + noatime, for the rootflags sync-drift VM scenario (scripts/vmtest/guest-rootflags-drift.sh): sync must capture noatime alongside compress-force, and the kernel's compression-level normalization (zstd -> zstd:3) must not make plan re-announce a change nobody made. Autologins root on ttyS0 and ships python-pydantic/python-colorama so the driver gets a shell with dasik importable, no network needed. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32",
           "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs",
           "partition_type": "linux", "mountpoint": "/", "format": true,
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/",
              "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@home", "mountpoint": "/home",
              "mount_options": ["compress-force=zstd", "noatime"]}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": false,
  "hostname": "dasik-rootflags",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {
    "selected_locales": ["en_US.UTF-8 UTF-8"],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {"type": "systemd-networkd"},
  "packages": ["base", "linux", "linux-firmware", "btrfs-progs",
               "python", "python-pydantic", "python-colorama"],
  "files": [
    {"path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
     "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"}
  ]
}
