{
  "metadata": {
    "note": "Container runtime (rootless podman + podman-docker) for the QEMU VM harness (scripts/vmtest/qemu.sh install-driven). Proves the subuid/subgid maps land and that `docker` on the command line is podman. Targets the guest's /dev/vda. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "ext4", "partition_type": "linux", "mountpoint": "/", "format": true}
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": ["base", "linux", "linux-firmware", "sudo"],
  "bootloader": "sd-boot",
  "hostname": "dasik-containers",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "containers": {
    "runtime": "podman",
    "rootless": true,
    "docker_compat": true,
    "api_socket": true
  },
  "users": [
    {
      "username": "test",
      "hashed_password": "$6$dasikvmtest$pfoSKqgh8yWKbmkwBpNuvQuJ4/kLeJmwCPCezBolW4pKbtJbtvMGQCM5f7W/hkbF/FmtCMZMYr/NLwDO4OJm7.",
      "groups": ["wheel"]
    }
  ]
}
