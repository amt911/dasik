  "udev_rules": [
    {
      "name": "1-qudelix.rules",
      "content": "# 96Hz\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4003\", MODE=\"0660\", TAG+=\"uaccess\"\n\n# 88.2Hz\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4004\", MODE=\"0660\", TAG+=\"uaccess\"\n\n# 48Hz\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4005\", MODE=\"0660\", TAG+=\"uaccess\"\n\n# 44.1Hz\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4006\", MODE=\"0660\", TAG+=\"uaccess\"\n\n# 44.1Hz/48/88.2/96Khz\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4007\", MODE=\"0660\", TAG+=\"uaccess\"\n\n# 48Hz with Mic\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4125\", MODE=\"0660\", TAG+=\"uaccess\"\n\n# 44.1Hz with Mic\nKERNEL==\"hidraw*\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"4126\", MODE=\"0660\", TAG+=\"uaccess\"\n"
    },
    {
      "name": "50-dolphin-UB400.rules",
      "content": "SUBSYSTEM==\"usb\", ATTRS{idVendor}==\"0a12\", ATTRS{idProduct}==\"0001\", MODE=\"0660\", TAG+=\"uaccess\"\n"
    }
  ],
  "modprobe_conf": [
    {
      "name": "nested_virt.conf",
      "content": "options kvm_amd nested=1\n"
    }
  ],
  "modules_load": [
    {
      "name": "virtio.conf",
      "content": "virtio-net\nvirtio-blk\nvirtio-scsi\nvirtio-serial\nvirtio-balloon\n"
    }
  ],
  "files": [
    {
      "path": "/etc/crypttab",
      "content": "# Configuration for encrypted block devices.\n# See crypttab(5) for details.\n\n# NOTE: Do not list your root (/) partition here, it must be set up\n#       beforehand by the initramfs (/etc/mkinitcpio.conf).\n\n# <name>       <device>                                     <password>              <options>\n# home         UUID=b8ad5c18-f445-495d-9095-c9ec4f9d2f37    /etc/mypassword1\n# data1        /dev/sda3                                    /etc/mypassword2\n# data2        /dev/sda5                                    /etc/cryptfs.key\n# swap         /dev/sdx4                                    /dev/urandom            swap,cipher=aes-cbc-essiv:sha256,size=256\n# vol          /dev/sdb7                                    none\n"
    },
    {
      "path": "/etc/plasmalogin.conf.d/10-dasik.conf",
      "content": "# Managed by dasik. Plasma Login Manager (plasmalogin.service) reads\n# /etc/plasmalogin.conf.d/*.conf — it is an SDDM fork, but it does NOT read\n# /etc/sddm.conf.d and it is fixed to the Breeze theme (no [Theme] key).\n# The previous sddm.conf.d \"DisplayServer=x11-user\" is intentionally NOT carried\n# over: plasmalogin defaults to Wayland. Re-add it only if you want X11 again.\n[Autologin]\nRelogin=false\nSession=plasma\nUser=andres\n\n[General]\nHaltCommand=/usr/bin/systemctl poweroff\nRebootCommand=/usr/bin/systemctl reboot\n\n[Users]\nMaximumUid=60513\nMinimumUid=1000\n"
    }
  ],
  "zram": {
    "zram0": {
      "swap-priority": "100",
      "zram-size": "min(ram / 2, 8192)"
    }
  },
  "firewall": {
    "enable": true,
    "allowed_services": [
      "samba",
      "samba-client",
      "samba-dc",
      "syncthing"
    ],
    "remove_services": [
      "ssh"
    ],
    "rich_rules": [
      "rule service name=\"ssh\" accept limit value=\"2/m\""
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": true,
  "snapper": {
    "enable": true,
    "configs": [
      {
        "name": "root",
        "subvolume": "/"
      }
    ]
  },
