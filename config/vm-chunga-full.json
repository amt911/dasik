{
  "metadata": {
    "note": "Full 'chunga' combined-stack test for the QEMU harness (DASIK_VM_TPM=1). LUKS2+TPM2 on encrypted btrfs (@/@home/@snapshots) + snapper + swap + multilib + kvm + bluetooth + cups + firewall + wireguard + hardware acceleration + a user + one AUR package (built from source) — the whole stack together. Adds autologin root on ttyS0 + python/pydantic/colorama so the installed system can be driven for day-2 / rollback / sync (unlock with the LUKS passphrase 'chungapass'). Excludes nvidia (no GPU in a VM). NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "swap", "size": "1GiB", "filesystem": "swap", "partition_type": "linux-swap", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs", "partition_type": "linux", "mountpoint": "/", "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "chungapass", "unlock_tpm2": true,
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@home", "mountpoint": "/home", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@snapshots", "mountpoint": "/.snapshots", "mount_options": ["compress-force=zstd", "noatime"]}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": false,
  "hostname": "dasik-chunga",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "packages": ["base", "linux", "linux-firmware", "btrfs-progs", "lib32-glibc", "python", "python-pydantic", "python-colorama", "aur-downgrade"],
  "pacman": {"multilib": true},
  "snapper": {"enable": true},
  "users": [
    {"username": "alice", "hashed_password": "$6$uKZMr4pT7dysjTW.$45fYDwbwrkeSPx238aFpIF0DM5YBp7Km3xS2rnhHb5jZbbgqTL7Qgjs9NFa3r82fPhJacdlsZgkW5.E3Zv6o..", "shell": "/bin/bash", "groups": ["wheel"]}
  ],
  "kvm": {"install": true},
  "bluetooth": {"enable": true, "package": "bluez"},
  "cups": {"install": true},
  "firewall": {"enable": true, "allowed_services": ["syncthing"], "rich_rules": ["rule service name=\"ssh\" accept limit value=\"2/m\""]},
  "wireguard": [{"name": "wg0", "source": "wg/example.conf"}],
  "hardware_acceleration": {"enable": true, "install_codecs": true},
  "files": [
    {"path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
     "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"}
  ]
}
