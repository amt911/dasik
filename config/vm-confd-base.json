{
  "metadata": {
    "note": "Baseline for the /etc/dracut.conf.d input check: an encrypted btrfs root (so dasik turns dracut's hostonly on, which is what makes the directory's contents matter) and nothing in that directory but dasik's own file. Its sibling vm-confd-dropin.json is the same config plus one foreign drop-in. scripts/vmtest/guest-dracut-conf-d.sh drives both against the live host. Public test passphrase 'confdpass'. NOT for real hardware.",
    "sizing": "DASIK_VM_RAM=4096 DASIK_VM_DISK=16G"
  },
  "hostname": "dasik-confd",
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {
    "selected_locales": ["en_US.UTF-8 UTF-8"],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {"type": "systemd-networkd"},
  "bootloader": "sd-boot",
  "initramfs": "dracut",
  "enable_microcode": false,
  "packages": [
    "base", "linux", "linux-firmware", "btrfs-progs",
    "python", "python-pydantic", "python-colorama"
  ],
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": true,
        "partitions": [
          {"label": "esp", "size": "1GiB", "filesystem": "fat32", "partition_type": "esp",
           "mountpoint": "/boot", "format": true},
          {"label": "root", "size": "rest", "filesystem": "btrfs", "partition_type": "linux",
           "mountpoint": null, "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "confdpass",
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/"},
             {"name": "@home", "mountpoint": "/home"}
           ]}
        ]
      }
    ]
  },
  "kernel_cmdline": ["console=ttyS0,115200"],
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}
