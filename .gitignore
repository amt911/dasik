vars.sh
__pycache__
.mypy_cache

# Python packaging
*.egg-info/
dist/
build/
*.egg
.eggs/
.pip/

# Virtual environments
.venv/
venv/
env/
ENV/

# Offline Arch Wiki mirror (downloaded reference, not source)
arch-wiki/

# Bind-mounted old install-scripts repo (recreate with resources/bind-mount.sh)
resources/archlinux-script-installer/

# graphify generated graph (regenerate with /graphify; holds machine-specific paths)
graphify-out/

# Test artifacts
.coverage
.pytest_cache/
htmlcov/
# mutmut mutation-testing working dir
/mutants/
.mutmut-cache

# Local sync captures (user system inventory — never commit)
config/mysystem.json
config/mysystem.json.bak
config/test.json
config/test-config.json.bak

# dasik run logs (./dasik-<verb>-<date>.log) — local diagnostics, never commit.
# Also any install log pasted in for analysis: RunLogger records full argv, so a
# log may contain values from the config; it must never be committed or attached
# to a PR unsanitised (forensic report §9.13).
dasik-*.log
log-llm.log
*-install.log

# Split configs keep their secrets beside them; only the .example is tracked.
config/*/secrets/*
!config/*/secrets/*.example
