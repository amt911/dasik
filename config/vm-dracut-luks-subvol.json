{
  "metadata": {
    "note": "Reproducer for the eternal /dev/mapper/cryptroot boot hang: encrypted btrfs with the SYNCED root shape (partition mountpoint=null, / lives on the @ subvolume) + initramfs:dracut + sd-boot. Unlike vm-dracut.json (which keeps mountpoint=\"/\" on the partition), this exercises detect_root_fs via mounts_root AND the forced crypt/systemd/systemd-cryptsetup dracut modules. Public test passphrase 'subvolpass'; autologins root over serial. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": true,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs", "partition_type": "linux", "mountpoint": null, "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "subvolpass",
           "mount_options": ["compress-force=zstd:3"],
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/"},
             {"name": "@home", "mountpoint": "/home"}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": false,
  "initramfs": "dracut",
  "hostname": "dasik-subvol",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "packages": ["base", "linux", "linux-firmware", "btrfs-progs", "python", "python-pydantic", "python-colorama"],
  "files": [
    {"path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
     "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"}
  ]
}
