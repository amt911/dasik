{
  "metadata": {
    "note": "btrfs (@/@home/@.snapshots, dasik's own recommended layout per dasik/lib/wizard/recipes.py) + snapper + firewall(firewalld) for the snapper/firewall removal-semantics VM scenario (scripts/vmtest/guest-snapper-firewall-removal.sh). The separate @.snapshots mount is the harder case SnapperAction._delete_config specifically handles (see docs/FACTS.md FACT-SFRM-3). NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "btrfs",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true,
            "btrfs_subvolumes": [
              {
                "name": "@",
                "mountpoint": "/",
                "mount_options": [
                  "compress-force=zstd",
                  "noatime"
                ]
              },
              {
                "name": "@home",
                "mountpoint": "/home",
                "mount_options": [
                  "compress-force=zstd",
                  "noatime"
                ]
              },
              {
                "name": "@.snapshots",
                "mountpoint": "/.snapshots",
                "mount_options": [
                  "compress-force=zstd",
                  "noatime"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "btrfs-progs",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-snap-fw",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {
    "type": "systemd-networkd"
  },
  "snapper": {
    "enable": true
  },
  "firewall": {
    "enable": true,
    "allowed_services": [
      "samba"
    ]
  },
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}