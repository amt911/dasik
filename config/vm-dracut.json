{
  "metadata": {
    "note": "dracut generator end-to-end: encrypted btrfs (passphrase) + initramfs:dracut + bluetooth.in_initramfs. Verifies dasik installs dracut, writes /etc/dracut.conf.d/dasik.conf (crypt+btrfs+bluetooth), neutralizes mkinitcpio's pacman hooks, regenerates via dracut, and the system BOOTS. No FIDO2 (needs a physical key the VM lacks) — that path is unit-tested. Autologins root + ships python so it can be driven. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs", "partition_type": "linux", "mountpoint": "/", "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "dracutpass",
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@home", "mountpoint": "/home", "mount_options": ["compress-force=zstd", "noatime"]}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": false,
  "initramfs": "dracut",
  "hostname": "dasik-dracut",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "bluetooth": {"enable": true, "in_initramfs": true},
  "plymouth": {"theme": "bgrt"},
  "packages": ["base", "linux", "linux-firmware", "btrfs-progs", "python", "python-pydantic", "python-colorama"],
  "files": [
    {"path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
     "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"}
  ]
}
