{
  "metadata": {
    "note": "ufw firewall backend (smb + syncthing) for the ufw removal-semantics VM scenario (scripts/vmtest/guest-ufw-removal.sh). Copy of vm-ufw.json + a baked-in ttyS0 autologin drop-in so the `drive` harness (which needs a shell on an ALREADY-installed guest, no LUKS/root-password prompt support) can log in. Targets the guest's /dev/vda. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-ufw",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "firewall": {
    "enable": true,
    "backend": "ufw",
    "rules": [
      "allow 22000/tcp",
      "allow 21027/udp",
      "allow 445/tcp",
      "allow 139/tcp",
      "limit 22/tcp"
    ]
  },
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}