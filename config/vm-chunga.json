{
  "metadata": {
    "note": "Núcleo 'chunga' para el harness QEMU (DASIK_VM_TPM=1): LUKS2+TPM2 sobre btrfs CIFRADO con subvolúmenes @/@home/@snapshots, snapper, swap y multilib (lib32-glibc, verifica el sync de la DB). Sin steam/nvidia/AUR (solo pacman/AUR, no lógica de dasik). Targetea /dev/vda. NO para hardware real."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "swap", "size": "1GiB", "filesystem": "swap", "partition_type": "linux-swap", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs", "partition_type": "linux", "mountpoint": "/", "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "chungapass", "unlock_tpm2": true,
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@home", "mountpoint": "/home", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@snapshots", "mountpoint": "/.snapshots", "mount_options": ["compress-force=zstd", "noatime"]}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": false,
  "hostname": "dasik-chunga",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "packages": ["base", "linux", "linux-firmware", "btrfs-progs", "lib32-glibc"],
  "pacman": {"multilib": true},
  "snapper": {"enable": true}
}
