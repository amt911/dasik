{
  "metadata": {
    "note": "PLANTILLA: refleja un setup real dracut + LUKS + FIDO2 + teclado bluetooth en initramfs, adaptado para un KVM (/dev/vda). Ajusta lo marcado con CAMBIAR-* para tu hardware real. FIDO2 necesita la llave física presente en el momento del install (enroll) y del arranque: en KVM, pásala con USB passthrough (ver docs). Para una prueba de humo SIN llave, pon unlock_fido2:false y usa solo la passphrase."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": true,
        "partitions": [
          {"label": "ESP", "size": "512MiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs", "partition_type": "linux", "mountpoint": "/", "format": true,
           "encrypt": true,
           "luks_name": "cryptroot",
           "luks_password": "cambia-esta-passphrase",
           "unlock_fido2": true,
           "luks_options": ["token-timeout=10s"],
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@home", "mountpoint": "/home", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@snapshots", "mountpoint": "/.snapshots", "mount_options": ["compress-force=zstd", "noatime"]}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "initramfs": "dracut",
  "enable_microcode": false,
  "hostname": "mi-equipo",
  "kernel_cmdline": ["console=ttyS0,115200", "sysrq_always_enabled=1", "zswap.enabled=0"],
  "timezone": {"region": "Europe", "city": "Madrid"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "bluetooth": {"enable": true, "in_initramfs": true},
  "packages": ["base", "linux", "linux-firmware", "btrfs-progs"]
}
