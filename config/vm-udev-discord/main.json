{
  "metadata": {
    "note": "Mirrors the shape dasik-personal-config uses to SHARE files between machines: the udev rules ride `files` through an $include'd fragment (common/udev-files.json, whose $include_text paths resolve relative to that fragment's own directory) and the Discord dotfile rides `home_tree`. Trimmed on purpose - the package set is the base plus what the harness needs, not a real machine's list. For scripts/vmtest/qemu.sh install-driven config/vm-udev-discord/main.json. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "bootloader": "sd-boot",
  "hostname": "dasik-udev-discord",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {
    "type": "systemd-networkd"
  },
  "home_tree": "common/home",
  "files": {
    "$concat": [
      [
        {
          "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
          "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
        }
      ],
      {
        "$include": "common/udev-files.json"
      }
    ]
  },
  "packages": {
    "$include": "packages.json"
  },
  "users": {
    "$include": "users.json"
  }
}
