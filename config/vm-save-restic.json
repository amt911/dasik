{
  "metadata": {
    "note": "dasik save --home with config-saver 3.5.0's restic store: the backups are snapshots, not files on disk, so save must export them before publishing. config-saver built from its Git PKGBUILD at the 3.5.0 merge, plus restic and age. For the QEMU VM harness (scripts/vmtest/qemu.sh install-driven + guest-save-restic.sh). NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "sudo",
    "git",
    "python",
    "python-pydantic",
    "python-colorama",
    "restic",
    "age"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-save-restic",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {
    "type": "systemd-networkd"
  },
  "config_saver": {
    "source": {
      "url": "https://github.com/amt911/config-saver-aur.git",
      "ref": "cda65fc7c300e20351e1257fb50b2060862c68ae"
    },
    "configs": {
      "dotfiles": {
        "normalize_content": true,
        "directories": [
          {
            "source": "$HOME",
            "files": [
              ".bashrc"
            ]
          }
        ]
      }
    },
    "timer_users": [
      "test"
    ]
  },
  "users": [
    {
      "username": "test",
      "hashed_password": "$6$dasikvmtest$pfoSKqgh8yWKbmkwBpNuvQuJ4/kLeJmwCPCezBolW4pKbtJbtvMGQCM5f7W/hkbF/FmtCMZMYr/NLwDO4OJm7.",
      "groups": [
        "wheel"
      ]
    }
  ],
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}
