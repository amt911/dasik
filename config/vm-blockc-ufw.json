{
  "metadata": {
    "note": "ufw + apparmor + pam + random-key swap, together: the block-C stack re-verified after the later merges. QEMU harness only (guest /dev/vda)."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": true,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "swap",
            "size": "1GiB",
            "filesystem": "swap",
            "partition_type": "linux-swap",
            "format": true,
            "swap_encryption": "random"
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "sudo",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-blockc",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "firewall": {
    "enable": true,
    "backend": "ufw",
    "rules": [
      "allow 22000/tcp",
      "allow 21027/udp",
      "allow 445/tcp",
      "allow 139/tcp",
      "limit 22/tcp"
    ]
  },
  "network": {
    "type": "systemd-networkd"
  },
  "users": [
    {
      "username": "test",
      "hashed_password": "$6$dasikvmtest$pfoSKkKQvVJXbEQ0eHtDdRlpUvhRAqhBl.tsklSPmb8Y2GfN5oQuJI1CDlYtNGTdNTuRfaVGqDbBaSPUvvxNS.",
      "groups": [
        "wheel"
      ]
    }
  ],
  "sudo": {
    "wheel": true
  },
  "initramfs": "dracut",
  "apparmor": {
    "enable": true,
    "audit": true
  },
  "pam": {
    "faillock": {
      "deny": 5,
      "unlock_time": 600,
      "persistent": true
    },
    "limits": {
      "nproc_soft": 100,
      "nproc_hard": 200
    },
    "pwquality": {
      "enable": true,
      "minlen": 10
    }
  },
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}
