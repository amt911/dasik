{
  "metadata": {
    "note": "Day-2 btrfs subvolume test (add / move / remove @data). Boots the INSTALLED system and applies against target / (the live host); autologins root on ttyS0; ships python-pydantic/python-colorama via pacman so dasik runs from the 9p-mounted repo with no network. For the QEMU VM harness, targets the guest /dev/vda. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "btrfs",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true,
            "btrfs_subvolumes": [
              {
                "name": "@",
                "mountpoint": "/",
                "mount_options": [
                  "compress-force=zstd",
                  "noatime"
                ]
              },
              {
                "name": "@home",
                "mountpoint": "/home",
                "mount_options": [
                  "compress-force=zstd",
                  "noatime"
                ]
              },
              {
                "name": "@snapshots",
                "mountpoint": "/.snapshots",
                "mount_options": [
                  "compress-force=zstd",
                  "noatime"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "btrfs-progs",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-subvol",
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {
    "type": "systemd-networkd"
  },
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}
