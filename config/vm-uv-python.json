{
  "metadata": {
    "note": "Two things one install can prove: a `uv_tools` entry that pins its interpreter (`uv tool install --python`), and `ai_skills` healing a codex marketplace whose cached root is gone while config.toml still registers it. For scripts/vmtest/qemu.sh install-driven config/vm-uv-python.json, then drive with guest-uv-python.sh and guest-codex-ghost.sh. Needs NETWORK (uv downloads the 3.13 interpreter; npm installs the codex CLI). Trimmed package set on purpose. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "sudo",
    "git",
    "nodejs",
    "npm",
    "uv",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-uv-python",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
