  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    },
    {
      "path": "/etc/codex/config.toml",
      "content": "# System layer: Codex reads /etc/codex/config.toml BELOW ~/.codex/config.toml,\n# so this reaches every user without touching the per-user file Codex itself\n# rewrites (project trust, hook hashes, plugins, MCP servers).\n#\n# The default project_doc_max_bytes is 32 KiB, and above it the tail of an\n# AGENTS.md is dropped without a word — dasik's is 57 KiB. Measured on the\n# tower with `codex debug prompt-input` inside the dasik repository: the last\n# section of AGENTS.md appears 0 times by default and once with this value.\nproject_doc_max_bytes = 524288\n"
    }
  ]
