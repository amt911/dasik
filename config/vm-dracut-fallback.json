{
  "metadata": {
    "note": "dracut fallback image + uhid + orphan pruning, end to end. Encrypted btrfs (passphrase 'fallbackpass') + initramfs:dracut + bluetooth.in_initramfs on sd-boot, with a deliberately small package set (no linux-firmware, no plymouth) so the two images per kernel build fast. Driven by scripts/vmtest/guest-dracut-fallback.sh, then booted FROM the rescue entry by guest-dracut-fallback-boot.sh. Autologins root over serial. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {"label": "ESP", "size": "1GiB", "filesystem": "fat32", "partition_type": "esp", "mountpoint": "/boot", "format": true},
          {"label": "ROOT", "size": "rest", "filesystem": "btrfs", "partition_type": "linux", "mountpoint": "/", "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "fallbackpass",
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/", "mount_options": ["compress-force=zstd", "noatime"]},
             {"name": "@home", "mountpoint": "/home", "mount_options": ["compress-force=zstd", "noatime"]}
           ]}
        ]
      }
    ]
  },
  "bootloader": "sd-boot",
  "enable_microcode": false,
  "initramfs": "dracut",
  "hostname": "dasik-fallback",
  "kernel_cmdline": ["console=ttyS0,115200"],
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {"selected_locales": ["en_US.UTF-8 UTF-8"], "desired_locale": "en_US.UTF-8", "desired_tty_layout": "us"},
  "network": {"type": "systemd-networkd"},
  "bluetooth": {"enable": true, "in_initramfs": true},
  "packages": ["base", "linux", "btrfs-progs", "python", "python-pydantic", "python-colorama"],
  "files": [
    {"path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
     "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"}
  ]
}
