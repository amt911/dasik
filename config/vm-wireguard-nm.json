{
  "metadata": {
    "note": "A wg-quick .conf declared `backend: networkmanager`: dasik converts it with `nmcli --offline connection add`, which needs no daemon and so works inside the chroot an install runs in. Deliberately MINIMAL \u2014 base + networkmanager and nothing else \u2014 so the run costs a couple of minutes rather than pulling a desktop. For scripts/vmtest/qemu.sh install-driven, then drive guest-wireguard-nm.sh WGNM-DONE. Targets the guest's /dev/vda. NOT for real hardware."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": false,
        "partitions": [
          {
            "label": "ESP",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "ROOT",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true
          }
        ]
      }
    ]
  },
  "enable_microcode": false,
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "sudo",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "bootloader": "sd-boot",
  "hostname": "dasik-wgnm",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {
    "type": "NetworkManager"
  },
  "wireguard": [
    {
      "name": "vm-nm-tunnel",
      "source": "wg/vm-nm-tunnel.conf",
      "backend": "networkmanager",
      "enable": true
    }
  ],
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}
