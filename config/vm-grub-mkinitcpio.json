{
  "metadata": {
    "note": "The OTHER branch of the boot code: grub + mkinitcpio + LUKS ext4, with podman, home_files and zram. QEMU harness only (guest /dev/vda)."
  },
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": true,
        "partitions": [
          {
            "label": "esp",
            "size": "512MiB",
            "filesystem": "fat32",
            "partition_type": "esp",
            "mountpoint": "/boot",
            "format": true
          },
          {
            "label": "root",
            "size": "rest",
            "filesystem": "ext4",
            "partition_type": "linux",
            "mountpoint": "/",
            "format": true,
            "encrypt": true,
            "luks_name": "cryptroot",
            "luks_password": "grubpass"
          }
        ]
      }
    ]
  },
  "initramfs": "mkinitcpio",
  "bootloader": "grub",
  "enable_microcode": false,
  "hostname": "dasik-grub",
  "kernel_cmdline": [
    "console=ttyS0,115200"
  ],
  "timezone": {
    "region": "Etc",
    "city": "UTC"
  },
  "locales": {
    "selected_locales": [
      "en_US.UTF-8 UTF-8"
    ],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {
    "type": "systemd-networkd"
  },
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "sudo",
    "grub",
    "efibootmgr",
    "python",
    "python-pydantic",
    "python-colorama"
  ],
  "users": [
    {
      "username": "test",
      "hashed_password": "$6$dasikvmtest$pfoSKkKQvVJXbEQ0eHtDdRlpUvhRAqhBl.tsklSPmb8Y2GfN5oQuJI1CDlYtNGTdNTuRfaVGqDbBaSPUvvxNS.",
      "groups": [
        "wheel"
      ]
    }
  ],
  "sudo": {
    "wheel": true
  },
  "zram": {
    "zram0": {
      "zram-size": "min(ram / 4, 2048)"
    }
  },
  "containers": {
    "runtime": "podman",
    "rootless": true,
    "docker_compat": true
  },
  "home_files": [
    {
      "user": "test",
      "path": ".config/dasik/hello.conf",
      "content": "# Managed by dasik\ngreeting=hola\n",
      "mode": "0600"
    }
  ],
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    }
  ]
}
