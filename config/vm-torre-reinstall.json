{
  "metadata": {
    "note": "VM rehearsal of torre-amd-reinstall.json from the personal config repo: the desktop's reinstall onto the ThinkPad's layout. What is new for THIS machine and has never been exercised on it is hibernation — the old install had a 2GiB swap with a random key and no resume=, so the whole point here is a persistent-key LUKS swap the kernel can resume from. Also carries what makes the desktop the desktop: amd_pstate, amd-ucode, nvidia-open-dkms (the DKMS module path, not extramodules) and the omit_drivers drop-in that keeps it out of the initramfs. Swap is 4GiB against the harness's 4096MiB of RAM; the real machine's 32GiB matches its 32GiB. unlock_fido2 is FALSE here and 2 on the real machine: systemd-cryptenroll runs with check=True, so enrolling a key that is not plugged in aborts the apply. Public test passphrase 'hibpass'; autologins root over serial. NOT for real hardware.",
    "sizing": "DASIK_VM_RAM=4096 DASIK_VM_DISK=24G DASIK_VM_INSTALL_TIMEOUT=3600"
  },
  "hostname": "dasik-torre",
  "timezone": {"region": "Etc", "city": "UTC"},
  "locales": {
    "selected_locales": ["en_US.UTF-8 UTF-8"],
    "desired_locale": "en_US.UTF-8",
    "desired_tty_layout": "us"
  },
  "network": {"type": "systemd-networkd"},
  "pacman": {"options": {"Parallel": true, "Color": true}, "multilib": true},
  "bootloader": "sd-boot",
  "initramfs": "dracut",
  "enable_microcode": true,
  "enable_trim": true,
  "sysrq": true,
  "packages": [
    "base", "linux", "linux-firmware", "linux-headers", "dkms", "btrfs-progs",
    "python", "python-pydantic", "python-colorama",
    "amd-ucode", "nvidia-open-dkms", "nvidia-utils"
  ],
  "cpu": {
    "scaling_driver": "amd_pstate",
    "mode": "active",
    "power_profiles_daemon": true
  },
  "snapper": {"enable": true, "configs": [{"name": "root", "subvolume": "/"}]},
  "disks": {
    "disks": [
      {
        "device": "/dev/vda",
        "partition_table": "gpt",
        "wipe_disk": true,
        "partitions": [
          {"label": "esp", "size": "2GiB", "filesystem": "fat32", "partition_type": "esp",
           "mountpoint": "/boot", "format": true},
          {"label": "swap", "size": "4GiB", "filesystem": "swap", "partition_type": "linux-swap",
           "mountpoint": null, "format": true,
           "encrypt": true, "luks_name": "cryptswap", "luks_password": "hibpass",
           "unlock_fido2": false, "luks_options": ["token-timeout=10s"]},
          {"label": "root", "size": "rest", "filesystem": "btrfs", "partition_type": "linux",
           "mountpoint": null, "format": true,
           "encrypt": true, "luks_name": "cryptroot", "luks_password": "hibpass",
           "unlock_fido2": false, "luks_options": ["token-timeout=10s"],
           "mount_options": ["compress-force=zstd:3"],
           "btrfs_subvolumes": [
             {"name": "@", "mountpoint": "/"},
             {"name": "@srv", "mountpoint": "/srv"},
             {"name": "@snapshots", "mountpoint": "/.snapshots"},
             {"name": "@home", "mountpoint": "/home"},
             {"name": "@var_lib_containers", "mountpoint": "/var/lib/containers"},
             {"name": "@var_lib_libvirt", "mountpoint": "/var/lib/libvirt"},
             {"name": "@var_cache", "mountpoint": "/var/cache"},
             {"name": "@var_log", "mountpoint": "/var/log"},
             {"name": "@var_tmp", "mountpoint": "/var/tmp"},
             {"name": "@var_spool", "mountpoint": "/var/spool"}
           ]}
        ]
      }
    ]
  },
  "kernel_cmdline": [
    "console=ttyS0,115200",
    "usbcore.quirks=5566:0008:i",
    "zswap.enabled=0",
    "resume=/dev/mapper/cryptswap"
  ],
  "zram": {
    "zram0": {
      "swap-priority": "100",
      "zram-size": "min(ram / 2, 8192)"
    }
  },
  "files": [
    {
      "path": "/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf",
      "content": "[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I $TERM\n"
    },
    {
      "path": "/etc/dracut.conf.d/10-no-nvidia-early-kms.conf",
      "content": "# Managed by dasik. Keep the NVIDIA modules OUT of the initramfs: early KMS has\n# no access to NVreg_TemporaryFilePath (/var/tmp), which breaks hibernation.\nomit_drivers+=\" nvidia nvidia_modeset nvidia_uvm nvidia_drm \"\n"
    }
  ]
}
